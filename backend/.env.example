# Server & Security
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
COOKIE_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_MASTER_KEY=

# Database & Messaging Infrastructure
DATABASE_URL=postgresql://connectx:connectx_change_me@localhost:5432/connectx?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://connectx:connectx_change_me@localhost:5672

# Storage & File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400

# WebRTC TURN / STUN
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SEC=3600

# Email (SMTP) & Browser Web Push (VAPID)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bootstrap Super Admin Email (optional first-run claim)
BOOTSTRAP_SUPER_ADMIN_EMAIL=
